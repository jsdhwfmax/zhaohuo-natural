*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.png binary
*.dll binary
*.zip binary
# Preserve vendor and installed payload bytes across clones; manifests pin SHA-256.
Dependencies/** -text
Loader/** -text
BepInEx/** -text
Characters/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Frozen prompt/evidence records contain exact byte SHA-256 references.
Prompts/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
verification/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# A trailing tab represents the empty replacement column in original-fallback rows.
verification/character-runtime-evidence/*/portraits.tsv whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
verification/character-runtime-evidence-v2.1/*/portraits.tsv whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Release acceptance binds the exact catalog bytes.
VariantCatalog.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# The offline probe pins the exact baseline bytes, including line endings.
installer/compatibility-baseline.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
installer/compatibility-baseline-25987745.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
installer/compatibility-baseline-26021712.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
installer/compatibility-baseline-26073097.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
verification/runtime-build25987745/*/portraits.tsv whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
